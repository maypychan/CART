# This file tells people how to cite CART. GitHub reads it and shows a
# "Cite this repository" button on the repository page.
# Format: Citation File Format 1.2.0 (https://citation-file-format.github.io/)
cff-version: 1.2.0
message: "If you use CART in research, please cite it as below."
type: software
title: "CART: CAPE-Vr Clinical Acoustic Reporting Tool"
version: 0.1.0
authors:
  - family-names: Chan
    given-names: May Pik Yu
    orcid: "https://orcid.org/0000-0003-2365-4093"
repository-code: "https://github.com/maypychan/CART"
url: "https://maypychan.github.io/CART/"
abstract: >-
  A browser-based tool for completing the Consensus Auditory-Perceptual
  Evaluation of Voice – Revised (CAPE-Vr). Optionally, it prepares an
  acoustic analysis for Praat, imports the results, and produces a
  combined, printable report.
keywords:
  - CAPE-Vr
  - voice
  - auditory-perceptual evaluation
  - acoustic analysis
  - Praat
references:
  - type: article
    title: "Development and rationale for the Consensus Auditory-Perceptual Evaluation of Voice—Revised (CAPE-Vr)"
    authors:
      - family-names: Kempster
        given-names: Gail B.
      - family-names: Nagle
        given-names: Kathleen F.
      - family-names: Solomon
        given-names: Nancy Pearl
    journal: "Journal of Voice"
    year: 2025
    doi: 10.1016/j.jvoice.2025.01.022
  - type: software
    title: "Praat: doing phonetics by computer"
    authors:
      - family-names: Boersma
        given-names: Paul
      - family-names: Weenink
        given-names: David
    url: "https://www.praat.org"
